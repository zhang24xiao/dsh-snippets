{
  "name": "dsh-snippets",
  "version": "0.4.0",
  "description": "CSS and JS snippet manager for the DeepSeek Harness web GUI. A sidebar-footer quick toggle opens a manager panel, and the plugin's page in the official Plugins manager carries a collapsible settings card; enabled CSS is injected as style elements and enabled JS runs in the page, so only trusted code should be enabled. Also mirrors a local folder of .css/.js files and publishes or imports a library through the GitHub Gist API. · DSH Web 代码片段管理器：侧栏底部快捷开关打开管理面板，设置卡片放在官方插件管理里本包自己的页面上；启用的 CSS 注入为 style 元素，启用的 JS 在页面内执行（无沙箱，只启用可信代码）；并支持本地文件夹监听与 Gist 同步。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.1"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "snippets",
    "css",
    "javascript",
    "userstyle",
    "userchrome",
    "代码片段"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang24xiao/dsh-snippets.git"
  },
  "homepage": "https://github.com/zhang24xiao/dsh-snippets",
  "bugs": {
    "url": "https://github.com/zhang24xiao/dsh-snippets/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "build:test": "node scripts/build-tests.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run build:test && node test/host.test.mjs && node test/client.test.mjs && node test/cordis.test.mjs && node test/client-modules.test.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@lezer/highlight": "^1.2.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3"
  }
}
